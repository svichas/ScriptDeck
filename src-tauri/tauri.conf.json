{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScriptDeck",
  "version": "0.4.1",
  "identifier": "com.scriptdec.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "url": "popover.html",
        "title": "ScriptDeck",
        "width": 380,
        "height": 540,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQkEyNkJDOTZCQTA4N0MKUldSOENMcVd2Q2E2TVBOZCsxNElNb0ZLZDMvVTlhNjNQeVBIMDFhZGZTZjI2Ly9tbU5iYkRwM04K",
      "endpoints": ["https://github.com/svichas/ScriptDeck/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Run your package.json scripts from the menu bar",
    "copyright": "Copyright © 2026 Stefanos Vichas. MIT License.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-" }
  }
}
